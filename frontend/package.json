{
  "name": "aps-dev-test-frontend",
  "version": "1.0.0",
  "description": "Frontend for APS Developer Test base application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --environment jsdom --pool=forks --poolOptions.forks.singleFork=true",
    "test:smoke": "vitest run --environment jsdom --pool=forks --poolOptions.forks.singleFork=true src/test/smoke.test.jsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "24.1.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^6.3.5",
    "vitest": "3.2.6"
  }
}
